<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Tweaker.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tweaker.UI"
    xmlns:resources="using:Tweaker.UI.Features.Common.Resources">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 3 native controls resources -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Value converters -->
                <ResourceDictionary Source="ms-appx:///Features/Common/Resources/Converters.xaml" />
                <!-- Shared setting templates and styles (code-behind enabled for x:Bind) -->
                <resources:SettingTemplates />
                <!-- Centralized feature icons -->
                <ResourceDictionary Source="ms-appx:///Features/Common/Resources/FeatureIcons.xaml" />
                <!-- InfoBadge pill styles, foreground brushes, and icon template selector -->
                <ResourceDictionary Source="ms-appx:///Features/Common/Resources/BadgeStyles.xaml" />
                <!-- Product-wide palette, typography, spacing, and control tokens -->
                <ResourceDictionary Source="ms-appx:///Features/Common/Resources/BrandTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Title Bar Button Style -->
            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BrandStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="9"/>
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="CornerRadius" Value="10"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
