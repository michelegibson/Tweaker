        <!-- High Contrast deliberately maps the branded surfaces to Windows
             system colors so navigation and actions remain legible. -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="BrandWindowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="BrandSidebarBrush" Color="{ThemeResource SystemColorWindowColor}"/>
