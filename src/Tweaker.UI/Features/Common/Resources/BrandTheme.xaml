    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6757F5" Offset="0"/>
        <GradientStop Color="#FF4D72F7" Offset="0.52"/>
        <GradientStop Color="#FF21B8A8" Offset="1"/>
    </LinearGradientBrush>

    <Thickness x:Key="BrandPagePadding">28,22,28,24</Thickness>
    <Thickness x:Key="BrandPanelPadding">24</Thickness>
    <CornerRadius x:Key="BrandPanelCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="BrandCardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="BrandControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>

    <!-- Shared settings/layout tokens override the former dense defaults. -->
    <x:Double x:Key="SettingsContentMaxWidth">1120</x:Double>
    <Thickness x:Key="SettingsContentMargin">28,0,28,0</Thickness>
    <x:Double x:Key="SettingsCardSpacing">8</x:Double>
    <Thickness x:Key="SettingsCardPadding">18,15,18,15</Thickness>
    <Thickness x:Key="SettingsCardHeaderIconMargin">0,0,14,0</Thickness>
    <Thickness x:Key="SettingsExpanderItemPadding">18,14,18,14</Thickness>

    <Style x:Key="BrandPageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource BrandTextPrimaryBrush}"/>
        <Setter Property="CharacterSpacing" Value="-12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="MaxLines" Value="2"/>
    </Style>

    <Style x:Key="BrandPageDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{ThemeResource BrandTextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="BrandIconTileStyle" TargetType="Border">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="{ThemeResource BrandAccentSubtleBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BrandStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="BrandPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BrandPanelAltBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BrandStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource BrandPanelCornerRadius}"/>
    </Style>

    <Style x:Key="BrandToolbarButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="CornerRadius" Value="{StaticResource BrandControlCornerRadius}"/>
        <Setter Property="Background" Value="{ThemeResource BrandCardBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BrandStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="BrandPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="CornerRadius" Value="{StaticResource BrandControlCornerRadius}"/>
        <Setter Property="Background" Value="{ThemeResource BrandAccentBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource BrandOnAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="BrandSectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource BrandTextSecondaryBrush}"/>
        <Setter Property="CharacterSpacing" Value="45"/>
        <Setter Property="Margin" Value="2,12,0,6"/>
    </Style>
</ResourceDictionary>
