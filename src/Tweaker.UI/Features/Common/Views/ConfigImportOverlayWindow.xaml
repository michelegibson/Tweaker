<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tweaker.UI.Features.Common.Views.ConfigImportOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Modune">

    <Grid x:Name="RootGrid" Background="{ThemeResource BrandWindowBackgroundBrush}"
          AutomationProperties.LiveSetting="Assertive">
        <Ellipse Width="560" Height="560"
                 Margin="-360,-340,0,0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Fill="{StaticResource BrandGradientBrush}"
                 Opacity="0.1"/>
        <Ellipse Width="440" Height="440"
                 Margin="0,0,-260,-260"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Fill="{StaticResource BrandGradientBrush}"
                 Opacity="0.07"/>

        <Border Width="540"
                Padding="52,46"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource BrandPanelBrush}"
                BorderBrush="{ThemeResource BrandStrokeBrush}"
                BorderThickness="1"
                CornerRadius="28">
            <StackPanel HorizontalAlignment="Stretch" Spacing="22">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <Image x:Name="OverlayLogo" Width="92" Height="92"/>
                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="OverlayTitleText"
                                   HorizontalAlignment="Center"
                                   FontSize="42"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="-10"/>
                        <TextBlock x:Name="OverlayTaglineText"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{ThemeResource BrandTextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource BrandStrokeBrush}"/>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock x:Name="OverlayStatusText"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="OverlayDetailText"
                                   FontSize="12"
                                   Foreground="{ThemeResource BrandTextTertiaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ProgressRing x:Name="OverlayProgressRing"
                                  Grid.Column="1"
                                  IsActive="True"
                                  Width="24" Height="24"
                                  VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
